@@ -0,0 +1,79 @@
+#!/usr/bin/env python
+"""
+预生成 PDMS metric_cache 的明文 sidecar (*.plane), 省去打分 worker 冷加载时的 lzma 解压开销。
+训练时自动优先读取, 带 mtime 校验。
+
+用法: python scripts/bench/prepare_pdm_plain_caches.py [--root <cache根>] [--workers N]
+"""
+from __future__ import annotations
+
+import argparse
+import glob
+import lzma
+import os
+import pickle
+import sys
+import time
+from concurrent.futures import ProcessPoolExecutor
+
+DEFAULT_ROOT_CANDIDATES = [
+    os.path.join(os.environ.get("NAVSIM_EXP_ROOT", "exp"), "train_pdm_cache"),
+    os.path.join(os.environ.get("NAVSIM_EXP_ROOT", "exp"), "val_pdm_cache"),
+]
+
+
+def _convert_one(path: str) -> tuple[str, str]:
+    """解压单个 metric_cache.pkl 为明文 sidecar; 返回 (path, status)。"""
+    plane = path + ".plane"
+    try:
+        src_mtime = os.path.getmtime(path)
+        if os.path.exists(plane) and os.path.getmtime(plane) >= src_mtime:
+            return path, "skip"
+        with lzma.open(path, "rb") as f:
+            obj = pickle.load(f)
+        with open(plane, "wb") as f:
+            pickle.dump(obj, f, protocol=pickle.HIGHEST_PROTOCOL)
+        return path, "ok"
+    except Exception as e:  # noqa: BLE001
+        return path, f"ERR {e}"
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--root", default=None, help="train_pdm_cache 根目录(含若干 token 子目录)")
+    ap.add_argument("--workers", type=int, default=64, help="并行进程数")
+    args = ap.parse_args()
+
+    root = args.root or os.environ.get("PDM_CACHE_ROOT") or DEFAULT_ROOT_CANDIDATES[0]
+    # 布局: <root>/<scene>/<subdir>/<token>/metric_cache.pkl (scene 下有 unknown 等子目录)
+    patterns = [
+        os.path.join(root, "*", "*", "*", "metric_cache.pkl"),
+        os.path.join(root, "*", "*", "metric_cache.pkl"),
+    ]
+    paths = set()
+    for pat in patterns:
+        paths.update(glob.glob(pat))
+    paths = sorted(paths)
+    if not paths:
+        print(f"no metric_cache.pkl found under {root}")
+        sys.exit(1)
+    print(f"converting {len(paths)} caches under {root} with {args.workers} workers...")
+    t0 = time.perf_counter()
+    ok = err = skip = 0
+    with ProcessPoolExecutor(max_workers=args.workers) as ex:
+        for path, status in ex.map(_convert_one, paths, chunksize=16):
+            if status == "ok":
+                ok += 1
+            elif status == "skip":
+                skip += 1
+            else:
+                err += 1
+                print(f"  FAIL {path}: {status}", file=sys.stderr)
+    dt = time.perf_counter() - t0
+    print(f"done: ok={ok} skip={skip} err={err} in {dt:.1f}s ({len(paths)/max(dt,1e-9):.0f} files/s)")
+    if err:
+        sys.exit(2)
+
+
+if __name__ == "__main__":
+    main()
