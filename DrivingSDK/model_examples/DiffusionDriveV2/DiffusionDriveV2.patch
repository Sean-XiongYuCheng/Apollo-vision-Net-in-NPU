+"""
+轻量 PDMS 打分 worker (spawn pool 用): 只依赖 numpy/shapely, 不 import torch/torch_npu。
+入口: pdm_worker (RL), pdm_worker_sel (SEL, 额外返回 sim_traj)；逻辑与原先逐位一致。
+"""
+from __future__ import annotations
+
+import numpy as np
+import numpy.typing as npt
+
+from navsim.evaluate.pdm_score import load_metric_cache_lru, pdm_score_para
+from navsim.planning.simulation.planner.pdm_planner.utils.pdm_enums import (
+    MultiMetricIndex,
+    WeightedMetricIndex as WIdx,
+)
+
+_SIMULATOR = None
+_SCORER = None
+
+
+def _init_pool(sim_cfg, scorer_cfg):
+    """ProcessPoolExecutor initializer: 在 worker 内实例化一次 simulator/scorer。"""
+    from hydra.utils import instantiate
+
+    global _SIMULATOR, _SCORER
+    _SIMULATOR = instantiate(sim_cfg)
+    _SCORER = instantiate(scorer_cfg)
+
+
+def _pairwise_subscores(scorer):
+    """从已打分 scorer 拆出各子指标与最终分数, shape=(G,) 与 proposal 对齐。"""
+    mm   = scorer._multi_metrics                # (3, N)
+    wm   = scorer._weighted_metrics.copy()      # <<< 一定要 copy !
+    prod = mm.prod(axis=0)                      # (N,)
+
+    wcoef  = scorer._config.weighted_metrics_array
+    thresh = scorer._config.progress_distance_threshold
+    prog_raw = scorer._progress_raw             # (N,)
+
+    # ---------- progress 归一化（与 _pairwise_scores 完全一致） ----------
+    raw_prog    = prog_raw * prod
+    raw_prog_gt = raw_prog[0]
+    max_pair    = np.maximum(raw_prog_gt, raw_prog[1:])           # (G,)
+
+    # 若 max_pair > thresh → 按比例归一；否则看 collision 情况
+    norm_prog   = np.where(
+        max_pair > thresh,
+        raw_prog[1:] / (max_pair + 1e-6),
+        np.where(prod[1:] == 0.0, 0.0, 1.0),
+    ).astype(np.float64)                                         # (G,)
+
+    # 把 progress 行（WeightedMetricIndex.PROGRESS）替换成新的
+    wm[WIdx.PROGRESS, 1:] = norm_prog
+
+    # --- 计算 weighted_metric_scores（与 _aggregate_scores 同式） ----
+    weighted_scores = (wm[:, 1:] * wcoef[:, None]).sum(axis=0)
+    weighted_scores /= wcoef.sum()                               # (G,)
+
+    final_scores = prod[1:] * weighted_scores                    # (G,)
+
+    # 子指标: 乘法指标 + 各加权指标 + progress + 最终分
+    subs = {
+        "no_collision":       mm[MultiMetricIndex.NO_COLLISION, 1:],
+        "drivable_area":      mm[MultiMetricIndex.DRIVABLE_AREA, 1:],
+        "progress":           norm_prog,
+        "ttc":                wm[WIdx.TTC, 1:],
+        "comfort":            wm[WIdx.COMFORTABLE, 1:],
+        "dir_weighted":       wm[WIdx.DRIVING_DIRECTION, 1:],
+        "prog_raw":           raw_prog[1:],
+        "final":              final_scores,
+    }
+    return {k: np.asarray(v, dtype=np.float64) for k, v in subs.items()}
+
+
+def _pairwise_scores(scorer) -> np.ndarray:
+    """用缓存的中间结果重算 "GT vs 每条候选" 得分, 返回 (N-1,) float32。"""
+    # --- 取中间量 ---------------------------------------------------
+    mm   = scorer._multi_metrics            # (M_mul, N)
+    wm   = scorer._weighted_metrics.copy()  # (M_wgt, N)  (复制以便我们改进程)
+    prog_raw = scorer._progress_raw         # (N,)
+    weight_coef = scorer._config.weighted_metrics_array  # (M_wgt,)
+
+    N = mm.shape[1]                         # proposals = 1(GT) + G
+    assert N >= 2, "Need at least GT + 1 proposal"
+
+    # --- 计算乘法指标乘积 ------------------------------------------
+    multi_prod = mm.prod(axis=0)            # (N,)
+
+    # --- 重新归一化 progress，每条候选只与 GT 对标 ------------------
+    raw_prog    = prog_raw * multi_prod     # (N,)
+    raw_prog_gt = raw_prog[0]
+
+    max_pair    = np.maximum(raw_prog_gt, raw_prog[1:])           # (G,)
+    thresh      = scorer._config.progress_distance_threshold
+
+    # 若 max_pair > thresh → 按比例归一；否则看 collision 情况
+    norm_prog   = np.where(
+        max_pair > thresh,
+        raw_prog[1:] / (max_pair + 1e-6),
+        np.where(multi_prod[1:] == 0.0, 0.0, 1.0),
+    ).astype(np.float64)                                         # (G,)
+
+    # 把 progress 行（WeightedMetricIndex.PROGRESS）替换成新的
+    wm[WIdx.PROGRESS, 1:] = norm_prog
+
+    # --- 计算 weighted_metric_scores（与 _aggregate_scores 同式） ----
+    weighted_scores = (wm[:, 1:] * weight_coef[:, None]).sum(axis=0)
+    weighted_scores /= weight_coef.sum()                         # (G,)
+
+    # --- 最终得分 = 乘法指标 × 加权指标 -----------------------------
+    final_scores = multi_prod[1:] * weighted_scores              # (G,)
+
+    return final_scores.astype(np.float32)                       # (G,)
+
+
+def _run_common(cache, traj_np) -> tuple:
+    """共享打分体: 加载 cache -> 状态向量化 -> 仿真 -> 打分 -> pairwise 重算。"""
+    # LRU 缓存 metric_cache (PDM_CACHE_SIZE 控制上限)
+    metric_cache = load_metric_cache_lru(cache)
+    results, sim_traj = pdm_score_para(
+        metric_cache=metric_cache,
+        model_trajectory=traj_np,                # (G, T, C)
+        future_sampling=_SIMULATOR.proposal_sampling,
+        simulator=_SIMULATOR,                    # 全局对象，见 initializer
+        scorer=_SCORER,
+    )
+    scores = _pairwise_scores(_SCORER)
+    subscores = _pairwise_subscores(_SCORER)
+    # 不把 ~220MB 的 metric_cache 回传父进程, 避免每 step 数十 GB 的 IPC 序列化
+    return scores.astype(np.float32), subscores, sim_traj.astype(np.float32)
+
+
+def pdm_worker(args):
+    """RL 模型用: 返回 (scores (G,), subscores dict)。"""
+    cache, traj_np = args
+    scores, subscores, _ = _run_common(cache, traj_np)
+    return scores, subscores                       # (G,)
+
+
+def pdm_worker_sel(args):
+    """SEL 模型用: 额外返回模拟轨迹 (G, T', 11)。"""
+    cache, traj_np = args
+    scores, subscores, sim_traj = _run_common(cache, traj_np)
+    return scores, subscores, sim_traj
