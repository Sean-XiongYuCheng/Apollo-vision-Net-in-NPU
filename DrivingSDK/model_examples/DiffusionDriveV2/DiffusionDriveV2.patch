+    lin[:, 1:, 2] = ay
+    lin[:, 0, 1] = x0
+    lin[:, 0, 2] = y0
+    lin[:, 0, 3] = initial_ego_state.dynamic_car_state.rear_axle_velocity_2d.x
+    lin[:, 0, 4] = initial_ego_state.dynamic_car_state.rear_axle_velocity_2d.y
