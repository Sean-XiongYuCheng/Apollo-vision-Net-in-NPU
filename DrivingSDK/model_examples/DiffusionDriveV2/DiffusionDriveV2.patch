+    ).astype(np.float64)
+
+    # 线性状态 (N, num_poses+1, 8): [tus, x, y, vx, vy, ax, ay, steer]
+    lin = np.zeros((n_batch, num_poses + 1, 8), dtype=np.float64)
+    lin[:, :, 0] = np.tile(t_ctrl_us, (n_batch, 1))
