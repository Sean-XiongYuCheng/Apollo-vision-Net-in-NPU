@@ -8,6 +8,46 @@ import numpy as np
 from omegaconf import DictConfig
 import torch
 
+# NPU environment variables (NOT including ALLOW_INTERNAL_FORMAT).
+os.environ.setdefault("COMBINED_ENABLE", "1")
+os.environ.setdefault("TORCHDYNAMO_DISABLE", "1")
+os.environ.setdefault("ENABLE_TENSORRT", "False")
+os.environ.setdefault("ATTENTION_BACKEND", "torch")
+os.environ.setdefault("NCCL_VERSION", "")
+
+import torch_npu
+from torch_npu.contrib import transfer_to_npu
+from mx_driving.patcher import default_patcher
+
+# Block GPU-only libraries BEFORE DreamZero module imports (matches
+# monkey-patch skip_import at patch.py:901). Without this,
+# transformer_engine/flash_attn get imported (CUDA versions) and corrupt
+# tensor format handling, causing aclnnCat 161002 (ND vs NCL mismatch).
+default_patcher.skip_import(
+    "transformer_engine",
+    "transformer_engine_torch",
+    "flash_attn",
+    "flash_attn_interface",
+    "sageattention",
+)
+
+# Add __version__ to stubs: DreamZero's cudnn_attention.py reads
+# transformer_engine.__version__ during import.
+import sys as _sys, importlib.machinery as _machinery
+for _name in ("transformer_engine", "transformer_engine_torch"):
+    _mod = _sys.modules.get(_name)
+    if _mod is not None and not hasattr(_mod, "__version__"):
+        _mod.__version__ = "0.0.0"
+        if getattr(_mod, "__spec__", None) is None:
+            _mod.__spec__ = _machinery.ModuleSpec(_name, loader=None, is_package=True)
+
+# Apply NPU patches BEFORE DreamZero imports (matches monkey-patch:
+# apply() at train_npu.py:60 before runpy.run_path at :69). Redirects
+# torch.cuda.* to torch_npu.npu.* so modules never capture unpatched CUDA.
+default_patcher.apply()
+
+torch_npu.npu.set_compile_mode(jit_compile=False)
+
