+        compile_kwargs: dict[str, Any] = {"dynamic": dynamic, "fullgraph": fullgraph}
+        backend_name = self.config.compile_inference_backend or "auto"
+        if backend is None:
+            device_type = next(self.parameters()).device.type
+            if backend_name in {None, "auto"}:
